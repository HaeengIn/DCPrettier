{
  "manifest_version": 3,
  "name": "DCPrettier",
  "description": "디시인사이드에서 불필요한 요소들을 삭제해줍니다.",
  "version": "1.0.0",
  "icons": {
    "16": "src/icon/16.png",
    "32": "src/icon/32.png",
    "48": "src/icon/48.png",
    "128": "src/icon/128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.dcinside.com/*", "*://event.dcinside.com/*"],
      "js": ["src/main.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://gall.dcinside.com/*"],
      "js": ["src/gall.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://m.dcinside.com/*"],
      "js": ["src/mobile/main.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://mall.dcinside.com/*", "*://dccon.dcinside.com/*"],
      "js": ["src/dccon.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
